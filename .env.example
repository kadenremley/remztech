# RemzTech Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git!

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://remztech.co.za
NEXT_PUBLIC_SITE_NAME=RemzTech
NEXT_PUBLIC_SITE_DESCRIPTION="Handbuilt software solutions. Direct access to your engineer. Modern solutions with smarter futures."

# Contact Information
NEXT_PUBLIC_WHATSAPP_NUMBER=27697530923
NEXT_PUBLIC_EMAIL=remztech@gmail.com
NEXT_PUBLIC_PHONE=+27 69 753 0923
NEXT_PUBLIC_LOCATION="Durban, KwaZulu-Natal, South Africa"

# Form Handling (choose ONE)
# Option A: Formspree (free tier: 50 submissions/month)
# Get your form ID at https://formspree.io
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Option B: Netlify Forms (free with Netlify hosting)
# If using Vercel + Netlify Forms, use Netlify's form endpoint
# NEXT_PUBLIC_NETLIFY_FORM_ENDPOINT=https://api.netlify.com/forms/your-form-id

# Decap CMS (Git Gateway / Netlify Identity)
# Enable in Netlify dashboard -> Identity -> Git Gateway
# No extra env vars needed if using Netlify Identity widget

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# reCAPTCHA (optional - for form spam protection)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key (server-side only, add to Vercel dashboard)